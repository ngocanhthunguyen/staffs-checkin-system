# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: office geofence (defaults in DB if not set)
# NEXT_PUBLIC_OFFICE_LAT=13.7563
# NEXT_PUBLIC_OFFICE_LNG=100.5018

# Required for the photo cleanup cron job (Settings → API → service_role key)
# NEVER expose this key to the browser — server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret Vercel Cron sends back to verify the request is genuine.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-secret

# Optional: how many days to keep check-in/out selfies before auto-deleting (default 90)
# PHOTO_RETENTION_DAYS=90

# Required to email managers/admins when a staff member submits a leave request.
# Get a free API key at https://resend.com (3,000 emails/month free).
RESEND_API_KEY=your-resend-api-key

# The "from" address for leave notification emails. Leave unset while testing
# (defaults to Resend's onboarding@resend.dev, which can only email the address
# you signed up to Resend with). Once you verify your domain in Resend
# (Domains → Add Domain), set this to an address on that domain, e.g.:
# LEAVE_NOTIFY_FROM_EMAIL=notifications@canaaustralasia.com

# Always CC these addresses on leave request notifications, in addition to
# whoever has the manager/admin role in the app (comma-separated for more than one).
LEAVE_NOTIFY_EXTRA_EMAILS=ngoc.anh.thu.nguyen@canaaustralasia.com
